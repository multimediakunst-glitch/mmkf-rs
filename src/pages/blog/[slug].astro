---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {

	const posts = await getCollection("blog");

	const sortedPosts = posts.sort(
		(a, b) =>
			b.data.date.valueOf() -
			a.data.date.valueOf()
	);


	return sortedPosts.map((post, index) => {

		const previousPost =
			index > 0
				? sortedPosts[index - 1]
				: null;


		const nextPost =
			index < sortedPosts.length - 1
				? sortedPosts[index + 1]
				: null;


		return {
			params: {
				slug: post.id
			},

			props: {
				post,
				previousPost,
				nextPost
			}
		};

	});
}


const {
	post,
	previousPost,
	nextPost
} = Astro.props;


const { Content } = await render(post);

---

<Layout title={`${post.data.title} – MMKF-RS`}>

	<section class="post-page">

		<header class="post-header">

			<a href="/blog" class="back">
				← BLOG
			</a>


			<h1>
				{post.data.title}
			</h1>


			{post.data.description && (
				<p class="description">
					{post.data.description}
				</p>
			)}

		</header>


		<article class="post-content">

			<Content />

		</article>


		<footer class="post-footer">

			{previousPost && (
				<a
					href={`/blog/${previousPost.id}`}
					class="post-navigation previous"
				>

					<span class="navigation-label">
						← VORHERIGER BEITRAG
					</span>

					<span class="navigation-title">
						{previousPost.data.title}
					</span>

				</a>
			)}


			{nextPost && (
				<a
					href={`/blog/${nextPost.id}`}
					class="post-navigation next"
				>

					<span class="navigation-label">
						NÄCHSTER BEITRAG →
					</span>

					<span class="navigation-title">
						{nextPost.data.title}
					</span>

				</a>
			)}

		</footer>

	</section>


	<!-- LIGHTBOX -->

	<div
		class="lightbox"
		id="lightbox"
	>

		<button
			class="lightbox-close"
			type="button"
			aria-label="Bild schließen"
		>
			×
		</button>


		<img
			class="lightbox-image"
			id="lightbox-image"
			src=""
			alt=""
		/>

	</div>


	<script>

		const images =
			document.querySelectorAll(
				".post-content img"
			);


		const lightbox =
			document.getElementById(
				"lightbox"
			);


		const lightboxImage =
			document.getElementById(
				"lightbox-image"
			);


		const closeButton =
			document.querySelector(
				".lightbox-close"
			);


		function closeLightbox() {

			lightbox?.classList.remove(
				"open"
			);

			document.body.classList.remove(
				"lightbox-open"
			);


			if (lightboxImage) {

				lightboxImage.setAttribute(
					"src",
					""
				);

			}

		}


		images.forEach((image) => {

			image.addEventListener(
				"click",
				() => {

					if (
						!lightbox ||
						!lightboxImage
					) {
						return;
					}


					lightboxImage.setAttribute(
						"src",
						image.getAttribute(
							"src"
						) || ""
					);


					lightboxImage.setAttribute(
						"alt",
						image.getAttribute(
							"alt"
						) || ""
					);


					lightbox.classList.add(
						"open"
					);


					document.body.classList.add(
						"lightbox-open"
					);

				}
			);

		});


		closeButton?.addEventListener(
			"click",
			closeLightbox
		);


		lightbox?.addEventListener(
			"click",
			(event) => {

				if (
					event.target === lightbox ||
					event.target === closeButton
				) {

					closeLightbox();

				}

			}
		);


		document.addEventListener(
			"keydown",
			(event) => {

				if (
					event.key === "Escape"
				) {

					closeLightbox();

				}

			}
		);

	</script>

</Layout>


<style>

	/* ========================================
	   SEITE
	   ======================================== */

	.post-page {

		width: 100%;

		max-width: 1100px;

		margin: 0 auto;

		padding:
			45px 40px 80px;

		box-sizing: border-box;
	}


	/* ========================================
	   HEADER
	   ======================================== */

	.post-header {

		margin-bottom: 35px;
	}


	.back {

		display: inline-block;

		margin-bottom: 25px;

		color: #888;

		font-size: 0.65rem;

		letter-spacing: 0.08em;

		text-decoration: none;
	}


	.back:hover {

		color: #fff;
	}


	.post-header h1 {

		margin: 0;

		color: #fff;

		font-size: 1.8rem;

		font-weight: 400;

		line-height: 1.3;

		letter-spacing: 0.02em;
	}


	.description {

		max-width: 700px;

		margin: 12px 0 0;

		color: #888;

		font-size: 0.75rem;

		line-height: 1.6;
	}


	/* ========================================
	   ARTIKEL
	   ======================================== */

	.post-content {

		width: 100%;

		max-width: 900px;

		margin: 0 auto;

		color: #ddd;

		font-size: 0.8rem;

		line-height: 1.7;
	}


	.post-content :global(> h1:first-child) {

		display: none;
	}


	.post-content :global(h1),
	.post-content :global(h2),
	.post-content :global(h3),
	.post-content :global(h4) {

		color: #fff;

		font-weight: 400;

		line-height: 1.35;
	}


	.post-content :global(h1) {

		margin: 0 0 25px;

		font-size: 1.5rem;
	}


	.post-content :global(h2) {

		margin: 40px 0 18px;

		font-size: 1.2rem;
	}


	.post-content :global(h3) {

		margin: 30px 0 15px;

		font-size: 1rem;
	}


	.post-content :global(p) {

		margin: 0 0 18px;
	}


	.post-content :global(a) {

		color: #fff;

		text-decoration: underline;

		text-underline-offset: 3px;
	}


	.post-content :global(ul),
	.post-content :global(ol) {

		margin: 0 0 22px;

		padding-left: 22px;
	}


	.post-content :global(li) {

		margin-bottom: 6px;
	}


	/* ========================================
	   BILDER
	   ======================================== */

	.post-content :global(img) {

		display: block;

		width: auto;

		max-width: 100%;

		height: auto;

		margin: 30px auto;

		object-fit: contain;

		cursor: zoom-in;

		transition:
			opacity 0.2s ease;
	}


	.post-content :global(img:hover) {

		opacity: 0.9;
	}


	.post-content :global(p:has(> img)) {

		margin: 30px 0;
	}


	.post-content :global(p:has(> img) img) {

		margin: 0 auto;
	}


	.post-content :global(figure) {

		width: 100%;

		margin: 35px 0;
	}


	.post-content :global(figure img) {

		margin: 0 auto;
	}


	.post-content :global(figcaption) {

		margin-top: 8px;

		color: #888;

		font-size: 0.65rem;

		line-height: 1.5;

		letter-spacing: 0.04em;
	}


	/* ========================================
	   BLOCKQUOTE
	   ======================================== */

	.post-content :global(blockquote) {

		margin: 30px 0;

		padding:
			3px 0 3px 20px;

		border-left:
			2px solid
			rgba(255, 255, 255, 0.4);

		color: #999;

		font-style: italic;
	}


	/* ========================================
	   CODE
	   ======================================== */

	.post-content :global(code) {

		padding: 2px 5px;

		background:
			rgba(0, 0, 0, 0.5);

		font-family:
			"IBM Plex Mono",
			monospace;
	}


	.post-content :global(pre) {

		overflow-x: auto;

		margin: 25px 0;

		padding: 16px;

		background:
			rgba(0, 0, 0, 0.7);

		border:
			1px solid
			rgba(255, 255, 255, 0.15);
	}


	.post-content :global(pre code) {

		padding: 0;

		background: none;
	}


	/* ========================================
	   ARTIKEL NAVIGATION
	   ======================================== */

	.post-footer {

		display: flex;

		justify-content: space-between;

		align-items: flex-start;

		gap: 30px;

		max-width: 900px;

		margin: 55px auto 0;

		padding-top: 20px;

		border-top:
			1px solid
			rgba(255, 255, 255, 0.2);
	}


	.post-navigation {

		display: flex;

		flex-direction: column;

		gap: 6px;

		color: #888;

		text-decoration: none;
	}


	.post-navigation.next {

		text-align: right;

		align-items: flex-end;
	}


	.post-navigation:hover {

		color: #fff;
	}


	.navigation-label {

		font-family:
			"IBM Plex Mono",
			monospace;

		font-size: 0.6rem;

		letter-spacing: 0.08em;
	}


	.navigation-title {

		color: #fff;

		font-size: 0.75rem;

		line-height: 1.5;
	}


	.post-navigation:hover
	.navigation-title {

		text-decoration: underline;

		text-underline-offset: 3px;
	}


	/* ========================================
	   LIGHTBOX
	   ======================================== */

	.lightbox {

		position: fixed;

		inset: 0;

		z-index: 9999;

		display: flex;

		align-items: center;

		justify-content: center;

		padding: 30px;

		box-sizing: border-box;

		background:
			rgba(0, 0, 0, 0.92);

		opacity: 0;

		visibility: hidden;

		pointer-events: none;

		transition:
			opacity 0.2s ease,
			visibility 0.2s ease;
	}


	.lightbox.open {

		opacity: 1;

		visibility: visible;

		pointer-events: auto;
	}


	.lightbox-image {

		display: block;

		width: 95vw;

		height: 92vh;

		object-fit: contain;

		cursor: default;
	}


	.lightbox-close {

		position: fixed;

		top: 20px;

		right: 25px;

		z-index: 10000;

		width: 45px;

		height: 45px;

		padding: 0;

		border: 0;

		background: none;

		color: #fff;

		font-family:
			"IBM Plex Mono",
			monospace;

		font-size: 2rem;

		font-weight: 300;

		line-height: 1;

		cursor: pointer;
	}


	.lightbox-close:hover {

		opacity: 0.7;
	}


	/* ========================================
	   LIGHTBOX BODY
	   ======================================== */

	:global(body.lightbox-open) {

		overflow: hidden;
	}


	/* ========================================
	   MOBIL
	   ======================================== */

	@media (max-width: 700px) {

		.post-page {

			padding:
				35px 20px 60px;
		}


		.post-header {

			margin-bottom: 30px;
		}


		.back {

			margin-bottom: 20px;
		}


		.post-header h1 {

			font-size: 1.4rem;

			line-height: 1.35;
		}


		.description {

			font-size: 0.7rem;
		}


		.post-content {

			font-size: 0.75rem;

			line-height: 1.7;
		}


		.post-content :global(h2) {

			margin-top: 30px;

			font-size: 1.05rem;
		}


		.post-content :global(h3) {

			margin-top: 25px;

			font-size: 0.9rem;
		}


		.post-content :global(img) {

			margin-top: 25px;

			margin-bottom: 25px;
		}


		/* NAVIGATION */

		.post-footer {

			gap: 15px;

			margin-top: 35px;
		}


		.navigation-label {

			font-size: 0.55rem;
		}


		.navigation-title {

			font-size: 0.7rem;
		}


		.lightbox {

			padding: 15px;
		}


		.lightbox-image {

			width: 100vw;

			height: 90vh;
		}


		.lightbox-close {

			top: 10px;

			right: 15px;
		}

	}

</style>