---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Blog – MMKF-RS">

	<section class="blog-page">

		<header class="page-header">

			<a href="/" class="back">
				← MMKF-RS
			</a>

			<h1>BLOG</h1>

		</header>


		<div class="post-list">

			{posts.map((post) => (

				<a
					href={`/blog/${post.id}`}
					class="post-card"
				>

					<div class="post-meta">

						<span>
							{post.data.date.toLocaleDateString(
								"de-AT",
								{
									day: "2-digit",
									month: "2-digit",
									year: "numeric"
								}
							)}
						</span>

					</div>


					<div class="post-info">

						<h2>
							{post.data.title}
						</h2>

						{post.data.description && (
							<p>
								{post.data.description}
							</p>
						)}

					</div>


					<div class="post-arrow">
						→
					</div>

				</a>

			))}

		</div>

	</section>

</Layout>


<style>

	.blog-page {
		max-width: 1100px;

		margin: 0 auto;

		padding: 70px 40px 120px;

		box-sizing: border-box;
	}


	/* HEADER */

	.page-header {
		padding-bottom: 30px;

		margin-bottom: 40px;

		border-bottom:
			1px solid
			rgba(255, 255, 255, 0.3);
	}


	.back {
		display: inline-block;

		margin-bottom: 40px;

		color: #aaa;

		font-size: 0.7rem;

		letter-spacing: 0.08em;

		text-decoration: none;
	}


	.back:hover {
		color: #fff;
	}


	h1 {
		margin: 0;

		font-size:
			clamp(2rem, 5vw, 4rem);

		font-weight: 400;

		letter-spacing: 0.04em;
	}


	/* BEITRÄGE */

	.post-list {
		display: flex;

		flex-direction: column;
	}


	.post-card {
		display: grid;

		grid-template-columns:
			140px 1fr 40px;

		gap: 30px;

		align-items: center;

		padding: 28px 20px;

		border-bottom:
			1px solid
			rgba(255, 255, 255, 0.2);

		color: #fff;

		background:
			rgba(10, 10, 10, 0.35);

		text-decoration: none;

		transition:
			background 0.2s ease,
			padding 0.2s ease;
	}


	.post-card:hover {
		background:
			rgba(10, 10, 10, 0.65);

		padding-left: 25px;

		padding-right: 25px;
	}


	.post-meta {
		color: #999;

		font-size: 0.7rem;

		letter-spacing: 0.05em;
	}


	.post-info h2 {
		margin: 0 0 8px;

		font-size: 1.2rem;

		font-weight: 400;
	}


	.post-info p {
		margin: 0;

		color: #aaa;

		font-size: 0.85rem;

		line-height: 1.6;
	}


	.post-arrow {
		color: #aaa;

		font-size: 1.2rem;

		text-align: right;

		transition:
			transform 0.2s ease,
			color 0.2s ease;
	}


	.post-card:hover .post-arrow {
		color: #fff;

		transform: translateX(4px);
	}


	/* LEERER BLOG */

	.post-list:empty::after {
		content: "NOCH KEINE BEITRÄGE";

		padding: 40px 0;

		color: #888;

		font-size: 0.7rem;

		letter-spacing: 0.1em;
	}


	/* MOBILE */

	@media (max-width: 700px) {

		.blog-page {
			padding:
				40px 20px 80px;
		}


		.post-card {

			grid-template-columns:
				1fr 30px;

			gap: 15px;

			padding:
				22px 10px;
		}


		.post-card:hover {

			padding-left: 15px;

			padding-right: 15px;
		}


		.post-meta {

			grid-column: 1 / -1;

			order: -1;
		}


		.post-info h2 {

			font-size: 1rem;
		}


		.post-info p {

			font-size: 0.8rem;
		}

	}

</style>