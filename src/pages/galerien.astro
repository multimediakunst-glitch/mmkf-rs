---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { getGalleries } from "../lib/gallery";

const galleries = getGalleries();

const galleryCards = await Promise.all(
	galleries.map(async (gallery) => ({
		name: gallery.name,
		preview:
			gallery.images.length > 0
				? await getImage({
						src: gallery.images[0].src,
						width: 1200,
						format: "webp",
						quality: 80
					})
				: null
	}))
);
---

<Layout title="Galerien – MMKF-RS">

	<section class="galleries-page">

		<div class="gallery-grid">

			{galleryCards.map((gallery) => (

				<a
					href={`/galerien/${encodeURIComponent(gallery.name)}`}
					class="gallery-card"
				>

					{gallery.preview && (
						<img
							src={gallery.preview.src}
							width={gallery.preview.width}
							height={gallery.preview.height}
							alt={gallery.name}
							loading="lazy"
						/>
					)}

				</a>

			))}

		</div>

	</section>

</Layout>


<style>

	.galleries-page {
		padding: 20px 40px 40px;
	}


	.gallery-grid {
		display: grid;

		grid-template-columns:
			repeat(
				auto-fit,
				minmax(220px, 1fr)
			);

		gap: 12px;

		max-width: 1200px;
	}


	.gallery-card {
		display: block;

		overflow: hidden;

		text-decoration: none;
	}


	.gallery-card img {
		display: block;

		width: 100%;
		height: auto;

		transition: opacity 0.2s ease;
	}


	.gallery-card:hover img {
		opacity: 0.85;
	}


	@media (max-width: 700px) {

		.galleries-page {
			padding: 20px 20px 40px;
		}

		.gallery-grid {
			grid-template-columns:
				repeat(
					auto-fit,
					minmax(160px, 1fr)
				);
		}

	}

</style>