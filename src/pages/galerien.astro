---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { getGalleries } from "../lib/gallery";

const galleries = getGalleries();

const galleryCards = await Promise.all(
	galleries.map(async (gallery) => ({
		name: gallery.name,
		preview: gallery.images.length > 0
			? await getImage({
				src: gallery.images[0].src,
				width: 1200,
				format: "webp",
				quality: 80
			})
			: null
	}))
);
---

<Layout title="Galerien – MMKF-RS">

	<section class="galleries-page">

		<header class="page-header">

			<a href="/" class="back">
				← MMKF-RS
			</a>

			<h1>GALERIEN</h1>

		</header>


		<div class="gallery-grid">

			{galleryCards.map((gallery) => (

				<a
					href={`/galerien/${encodeURIComponent(gallery.name)}`}
					class="gallery-card"
				>

					{gallery.preview && (
						<div class="gallery-preview">

							<img
								src={gallery.preview.src}
								width={gallery.preview.width}
								height={gallery.preview.height}
								alt={gallery.name}
								loading="lazy"
							/>

						</div>
					)}

					<div class="gallery-title">

						<span>
							{gallery.name}
						</span>

						<span>
							→
						</span>

					</div>

				</a>

			))}

		</div>

	</section>

</Layout>


<style>

	.galleries-page {
		padding: 60px 40px 100px;
	}

	.page-header {
		padding-bottom: 25px;
		margin-bottom: 40px;
		border-bottom: 1px solid #333;
	}

	.back {
		display: inline-block;
		margin-bottom: 25px;

		color: #888;

		font-size: 0.7rem;
		letter-spacing: 0.08em;

		text-decoration: none;
	}

	.back:hover {
		color: #fff;
	}

	h1 {
		margin: 0;

		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: 400;
		letter-spacing: 0.04em;
	}


	/* GALERIEN */

	.gallery-grid {
		display: grid;

		grid-template-columns: repeat(
			auto-fit,
			minmax(220px, 1fr)
		);

		gap: 12px;

		max-width: 1200px;
	}

	.gallery-card {
		display: block;

		background: #111;
		color: #fff;

		text-decoration: none;

		overflow: hidden;
	}

	.gallery-preview {
		width: 100%;
		aspect-ratio: 3 / 2;

		overflow: hidden;
	}

	.gallery-preview img {
		display: block;

		width: 100%;
		height: 100%;

		object-fit: cover;

		transition: transform 0.3s ease;
	}

	.gallery-card:hover .gallery-preview img {
		transform: scale(1.03);
	}

	.gallery-title {
		display: flex;

		justify-content: space-between;
		align-items: center;

		padding: 16px 14px;

		border-top: 1px solid #333;

		font-size: 0.75rem;
		letter-spacing: 0.08em;
	}

	.gallery-title span:last-child {
		font-size: 1rem;
	}


	@media (max-width: 700px) {

		.galleries-page {
			padding: 40px 20px 70px;
		}

		.gallery-grid {
			grid-template-columns: repeat(
				auto-fit,
				minmax(160px, 1fr)
			);
		}

	}

</style>