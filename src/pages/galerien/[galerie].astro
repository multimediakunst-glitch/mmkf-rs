---
import { getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { getGalleries } from "../../lib/gallery";

export function getStaticPaths() {
	const galleries = getGalleries();

	return galleries.map((gallery) => ({
		params: {
			galerie: gallery.name
		},
		props: {
			gallery
		}
	}));
}

const { gallery } = Astro.props;

const images = await Promise.all(
	gallery.images.map(async (image) => ({
		name: image.name,
		src: await getImage({
			src: image.src,
			width: 2400,
			format: "webp",
			quality: 85
		})
	}))
);
---

<Layout title={`${gallery.name} – MMKF-RS`}>

	<section class="gallery-page">

		<header class="page-header">

			<a href="/galerien" class="back">
				← GALERIEN
			</a>

			<h1>{gallery.name}</h1>

		</header>


		<div class="photo-grid">

			{images.map((image, index) => (
				<figure>

					<button
						class="photo-button"
						data-index={index}
						aria-label={`Foto ${index + 1} öffnen`}
					>

						<img
							src={image.src.src}
							width={image.src.width}
							height={image.src.height}
							alt={gallery.name}
							loading="lazy"
						/>

					</button>

				</figure>
			))}

		</div>

	</section>


	<div
		class="lightbox"
		id="lightbox"
		aria-hidden="true"
	>

		<button
			class="lightbox-close"
			id="lightbox-close"
			aria-label="Schließen"
		>
			×
		</button>

		<button
			class="lightbox-prev"
			id="lightbox-prev"
			aria-label="Vorheriges Foto"
		>
			←
		</button>

		<div class="lightbox-content">
			<img id="lightbox-image" src="" alt="" />
		</div>

		<button
			class="lightbox-next"
			id="lightbox-next"
			aria-label="Nächstes Foto"
		>
			→
		</button>

	</div>

</Layout>


<script define:vars={{
	images: images.map((image) => ({
		src: image.src.src,
		name: image.name
	}))
}}>
	const lightbox = document.getElementById("lightbox");
	const lightboxImage = document.getElementById("lightbox-image");
	const closeButton = document.getElementById("lightbox-close");
	const prevButton = document.getElementById("lightbox-prev");
	const nextButton = document.getElementById("lightbox-next");
	const photoButtons = document.querySelectorAll(".photo-button");

	let currentIndex = 0;

	function showImage(index) {
		currentIndex = (index + images.length) % images.length;

		lightboxImage.src = images[currentIndex].src;
		lightboxImage.alt = images[currentIndex].name;

		lightbox.classList.add("open");
		lightbox.setAttribute("aria-hidden", "false");

		document.body.classList.add("lightbox-open");
	}

	function closeLightbox() {
		lightbox.classList.remove("open");
		lightbox.setAttribute("aria-hidden", "true");

		document.body.classList.remove("lightbox-open");

		lightboxImage.src = "";
	}

	function previousImage() {
		showImage(currentIndex - 1);
	}

	function nextImage() {
		showImage(currentIndex + 1);
	}

	photoButtons.forEach((button) => {
		button.addEventListener("click", () => {
			showImage(Number(button.dataset.index));
		});
	});

	closeButton.addEventListener("click", closeLightbox);
	prevButton.addEventListener("click", previousImage);
	nextButton.addEventListener("click", nextImage);

	lightbox.addEventListener("click", (event) => {
		if (event.target === lightbox) {
			closeLightbox();
		}
	});

	document.addEventListener("keydown", (event) => {
		if (!lightbox.classList.contains("open")) {
			return;
		}

		if (event.key === "Escape") {
			closeLightbox();
		}

		if (event.key === "ArrowLeft") {
			previousImage();
		}

		if (event.key === "ArrowRight") {
			nextImage();
		}
	});
</script>


<style>

	.gallery-page {
		padding: 60px 40px 100px;
	}

	.page-header {
		padding-bottom: 25px;
		border-bottom: 1px solid #333;
		margin-bottom: 40px;
	}

	.back {
		display: inline-block;
		margin-bottom: 25px;
		color: #888;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-decoration: none;
	}

	.back:hover {
		color: #fff;
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: 400;
		letter-spacing: 0.04em;
	}


	/* GALERIE */

	.photo-grid {
		columns: 3 280px;
		column-gap: 12px;
	}

	.photo-grid figure {
		margin: 0 0 12px;
		break-inside: avoid;
	}

	.photo-button {
		display: block;
		width: 100%;
		padding: 0;
		margin: 0;
		border: 0;
		outline: 0;
		background: none;
		cursor: zoom-in;
	}

	.photo-button:focus,
	.photo-button:focus-visible {
		outline: none;
		border: 0;
	}

	.photo-grid img {
		display: block;
		width: 100%;
		height: auto;
	}

	.photo-button:hover img {
		opacity: 0.85;
	}


	/* LIGHTBOX */

	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 1000;

		display: flex;
		align-items: center;
		justify-content: center;

		background: #000;

		opacity: 0;
		visibility: hidden;
		pointer-events: none;

		transition: opacity 0.2s ease;
	}

	.lightbox.open {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}

	.lightbox-content {
		width: 100vw;
		height: 100vh;

		display: flex;
		align-items: center;
		justify-content: center;

		padding: 70px 90px;
		box-sizing: border-box;
	}

	.lightbox-content img {
		display: block;

		width: auto;
		height: auto;

		max-width: 100%;
		max-height: 100%;

		object-fit: contain;

		border: 0;
		outline: none;
		box-shadow: none;
	}

	.lightbox-close,
	.lightbox-prev,
	.lightbox-next {
		position: fixed;
		z-index: 1001;

		border: 0;
		background: none;
		color: #fff;

		font-family: inherit;
		cursor: pointer;

		opacity: 0.7;
	}

	.lightbox-close:hover,
	.lightbox-prev:hover,
	.lightbox-next:hover {
		opacity: 1;
	}

	.lightbox-close {
		top: 25px;
		right: 30px;

		font-size: 2rem;
		font-weight: 300;
	}

	.lightbox-prev,
	.lightbox-next {
		top: 50%;
		transform: translateY(-50%);

		font-size: 2rem;
	}

	.lightbox-prev {
		left: 25px;
	}

	.lightbox-next {
		right: 25px;
	}

	:global(body.lightbox-open) {
		overflow: hidden;
	}


	/* TABLET / MOBILE */

	@media (max-width: 700px) {

		.gallery-page {
			padding: 40px 20px 70px;
		}

		.photo-grid {
			columns: 2 160px;
			column-gap: 8px;
		}

		.lightbox-content {
			padding: 60px 50px;
		}

		.lightbox-prev {
			left: 10px;
		}

		.lightbox-next {
			right: 10px;
		}
	}

	@media (max-width: 450px) {

		.photo-grid {
			columns: 1;
		}

		.lightbox-content {
			padding: 55px 40px;
		}

	}

</style>