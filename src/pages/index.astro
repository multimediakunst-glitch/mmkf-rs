---
import Layout from "../layouts/Layout.astro";
import { getGalleries } from "../lib/gallery";

const galleries = getGalleries();

const blogPosts = import.meta.glob<string>(
	"/src/content/blog/*.md",
	{
		eager: true,
		query: "?raw",
		import: "default"
	}
);

const blogImages = import.meta.glob<string>(
	"/src/content/blog/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP}",
	{
		eager: true,
		query: "?url",
		import: "default"
	}
);


function getFrontmatter(text: string, key: string) {

	const match = text.match(
		new RegExp(`^${key}:\\s*["']?(.+?)["']?\\s*$`, "m")
	);

	return match ? match[1].trim() : "";
}


function getBlogPost(entry: [string, string]) {

	const [filePath, content] = entry;

	const fileName = filePath.split("/").pop() ?? "";

	const slug = fileName
		.replace(/\.md$/i, "")
		.toLowerCase();


	const title =
		getFrontmatter(content, "title") ||
		slug;


	const date =
		getFrontmatter(content, "date") ||
		"";


	const body = content
		.replace(/^---[\s\S]*?---/, "")
		.trim();


	const imageMatch = body.match(
		/!\[[^\]]*\]\(([^)]+)\)/
	);


	let image = null;


	if (imageMatch) {

		const imagePath = imageMatch[1]
			.replace(/^\.\//, "");


		const imageEntry = Object.entries(blogImages).find(
			([path]) =>
				path.endsWith("/" + imagePath)
		);


		if (imageEntry) {

			image = imageEntry[1];

		}

	}


	const teaser = body

		.replace(
			/!\[[^\]]*\]\([^)]+\)/g,
			""
		)

		.replace(
			/^#+\s+/gm,
			""
		)

		.replace(
			/\*\*([^*]+)\*\*/g,
			"$1"
		)

		.replace(
			/\*([^*]+)\*/g,
			"$1"
		)

		.replace(
			/`([^`]+)`/g,
			"$1"
		)

		.replace(
			/\[([^\]]+)\]\([^)]+\)/g,
			"$1"
		)

		.replace(
			/\s+/g,
			" "
		)

		.trim()

		.slice(0, 180);


	return {
		slug,
		title,
		date,
		image,
		teaser
	};

}


const posts = Object.entries(blogPosts)

	.map(getBlogPost)

	.sort(
		(a, b) =>
			b.date.localeCompare(a.date)
	)

	.slice(0, 3);

---

<Layout title="MMKF-RS">

	<section class="gallery-section">

		<div class="gallery-grid">

			{galleries.map((gallery) => (

				<a
					href={`/galerien/${encodeURIComponent(gallery.name)}`}
					class="gallery-card"
				>

					{gallery.images.length > 0 && (

						<img
							src={gallery.images[0].src.src}
							width={gallery.images[0].src.width}
							height={gallery.images[0].src.height}
							alt={gallery.name}
							loading="lazy"
						/>

					)}

				</a>

			))}

		</div>


		<div class="gallery-warning">

			<div class="warning-title">
				WARNING
			</div>

			<div class="warning-text">
				CLICKING THESE IMAGES MAY RESULT IN
				AN UNEXPECTED AMOUNT OF PHOTOGRAPHS.
			</div>

		</div>

	</section>


	<section class="blog-section">

		{posts.map((post) => (

			<a
				href={`/blog/${post.slug}`}
				class="blog-card"
			>

				<div class="blog-image">

					{post.image ? (

						<img
							src={post.image}
							alt={post.title}
							loading="lazy"
						/>

					) : (

						<div class="blog-placeholder">
							MMKF-RS
						</div>

					)}

				</div>


				<div class="blog-content">

					<h2>
						{post.title}
					</h2>


					<p>
						{post.teaser}
						{post.teaser.length >= 180
							? "..."
							: ""}
					</p>


					<span class="blog-link">
						BEITRAG ANSEHEN →
					</span>

				</div>

			</a>

		))}

	</section>

</Layout>


<style>

	.gallery-section {

		padding:
			20px 40px 40px;
	}


	.gallery-grid {

		display: grid;

		grid-template-columns:
			repeat(
				auto-fit,
				minmax(180px, 1fr)
			);

		gap: 12px;

		max-width: 1200px;
	}


	.gallery-card {

		display: block;

		overflow: hidden;

		text-decoration: none;
	}


	.gallery-card img {

		display: block;

		width: 100%;

		height: auto;

		transition:
			opacity 0.2s ease;
	}


	.gallery-card:hover img {

		opacity: 0.85;
	}


	/* WARNING */

	.gallery-warning {

		position: relative;

		display: flex;

		align-items: center;

		gap: 35px;

		max-width: 1100px;

		margin:
			25px auto 0;

		padding:
			18px 24px;

		background: #fff;

		color: #000;

		border:
			2px solid #000;

		font-family:
			"IBM Plex Mono",
			monospace;

		text-transform: uppercase;
	}


	.gallery-warning::after {

		content: "";

		position: absolute;

		inset: 5px;

		border:
			2px solid #000;

		pointer-events: none;
	}


	.warning-title {

		font-size: 1.4rem;

		font-weight: 700;

		letter-spacing: 0.08em;

		white-space: nowrap;
	}


	.warning-text {

		font-size: 0.75rem;

		line-height: 1.6;

		letter-spacing: 0.05em;
	}


	/* BLOG */

	.blog-section {

		max-width: 1000px;

		margin:
			0px auto 70px;

		padding:
			0 40px;
	}


	.blog-card {

		display: grid;

		grid-template-columns:
			240px 1fr;

		gap: 25px;

		margin-bottom: 30px;

		color: inherit;

		text-decoration: none;
	}


	.blog-image {

		width: 240px;

		height: 150px;

		overflow: hidden;
	}


	.blog-image img {

		display: block;

		width: 100%;

		height: 100%;

		object-fit: cover;
	}


	.blog-placeholder {

		display: flex;

		align-items: center;

		justify-content: center;

		width: 100%;

		height: 100%;

		background: #111;

		color: #fff;

		font-family:
			"IBM Plex Mono",
			monospace;

		font-size: 0.65rem;

		letter-spacing: 0.1em;
	}


	.blog-content {

		display: flex;

		flex-direction: column;

		justify-content: center;
	}


	.blog-content h2 {

		margin:
			0 0 8px;

		font-size: 1rem;

		font-weight: 400;

		color: #fff;
	}


	.blog-content p {

		margin:
			0 0 12px;

		max-width: 600px;

		font-size: 0.75rem;

		line-height: 1.6;

		color: #888;
	}


	.blog-link {

		font-family:
			"IBM Plex Mono",
			monospace;

		font-size: 0.65rem;

		letter-spacing: 0.08em;

		color: #fff;
	}


	.blog-card:hover .blog-image img {

		opacity: 0.85;
	}


	.blog-card:hover .blog-link {

		text-decoration: underline;
	}


	@media (max-width: 700px) {

		.gallery-section {

			padding-left: 20px;

			padding-right: 20px;
		}


		.gallery-grid {

			grid-template-columns:
				repeat(
					auto-fit,
					minmax(150px, 1fr)
				);
		}


		.gallery-warning {

			gap: 18px;

			margin-top: 20px;

			padding:
				14px 16px;
		}


		.warning-title {

			font-size: 1rem;
		}


		.warning-text {

			font-size: 0.65rem;
		}


		.blog-section {

			margin-top: 40px;

			padding:
				0 20px;
		}


		.blog-card {

			grid-template-columns: 1fr;

			gap: 12px;

			margin-bottom: 35px;
		}


		.blog-image {

			width: 100%;

			height: auto;

			aspect-ratio:
				3 / 2;
		}


		.blog-content h2 {

			font-size: 1rem;
		}


		.blog-content p {

			font-size: 0.7rem;
		}

	}

</style>