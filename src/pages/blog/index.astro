---
import Layout from "../../layouts/Layout.astro";

const blogPosts = import.meta.glob<string>(
	"/src/content/blog/*.md",
	{
		eager: true,
		query: "?raw",
		import: "default"
	}
);

const blogImages = import.meta.glob<string>(
	"/src/content/blog/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP}",
	{
		eager: true,
		query: "?url",
		import: "default"
	}
);


function getFrontmatter(text: string, key: string) {

	const match = text.match(
		new RegExp(`^${key}:\\s*["']?(.+?)["']?\\s*$`, "m")
	);

	return match ? match[1].trim() : "";
}


function getBlogPost(entry: [string, string]) {

	const [filePath, content] = entry;

	const fileName = filePath.split("/").pop() ?? "";

	/*
	 * Astro Content Collections verwenden für die ID
	 * eine Kleinschreibung.
	 *
	 * Deshalb muss der Link hier ebenfalls klein
	 * geschrieben werden.
	 */

	const slug = fileName
		.replace(/\.md$/i, "")
		.toLowerCase();


	const title =
		getFrontmatter(content, "title") ||
		slug;


	const date =
		getFrontmatter(content, "date") ||
		"";


	const body = content
		.replace(/^---[\s\S]*?---/, "")
		.trim();


	const imageMatch = body.match(
		/!\[[^\]]*\]\(([^)]+)\)/
	);


	let image = null;


	if (imageMatch) {

		const imagePath = imageMatch[1]
			.replace(/^\.\//, "");


		const imageEntry = Object.entries(
			blogImages
		).find(
			([path]) =>
				path.endsWith("/" + imagePath)
		);


		if (imageEntry) {

			image = imageEntry[1];

		}

	}


	const teaser = body

		.replace(
			/!\[[^\]]*\]\([^)]+\)/g,
			""
		)

		.replace(
			/^#+\s+/gm,
			""
		)

		.replace(
			/\*\*([^*]+)\*\*/g,
			"$1"
		)

		.replace(
			/\*([^*]+)\*/g,
			"$1"
		)

		.replace(
			/`([^`]+)`/g,
			"$1"
		)

		.replace(
			/\[([^\]]+)\]\([^)]+\)/g,
			"$1"
		)

		.replace(
			/\s+/g,
			" "
		)

		.trim()

		.slice(0, 180);


	return {
		slug,
		title,
		date,
		image,
		teaser
	};

}


const posts = Object.entries(blogPosts)

	.map(getBlogPost)

	.sort(
		(a, b) =>
			b.date.localeCompare(a.date)
	);

---

<Layout title="Blog – MMKF-RS">

	<section class="blog-section">

		{posts.map((post) => (

			<a
				href={`/blog/${post.slug}`}
				class="blog-card"
			>

				<div class="blog-image">

					{post.image ? (

						<img
							src={post.image}
							alt={post.title}
							loading="lazy"
						/>

					) : (

						<div class="blog-placeholder">
							MMKF-RS
						</div>

					)}

				</div>


				<div class="blog-content">

					<h2>
						{post.title}
					</h2>


					<p>
						{post.teaser}
						{post.teaser.length >= 180
							? "..."
							: ""}
					</p>


					<span class="blog-link">
						BEITRAG ANSEHEN →
					</span>

				</div>

			</a>

		))}

	</section>

</Layout>


<style>

	.blog-section {

		max-width: 1000px;

		margin:
			25px auto 70px;

		padding:
			0 40px;
	}


	.blog-card {

		display: grid;

		grid-template-columns:
			240px 1fr;

		gap: 25px;

		margin-bottom: 30px;

		color: #fff;

		text-decoration: none;
	}


	.blog-image {

		width: 240px;

		height: 150px;

		overflow: hidden;
	}


	.blog-image img {

		display: block;

		width: 100%;

		height: 100%;

		object-fit: cover;
	}


	.blog-placeholder {

		display: flex;

		align-items: center;

		justify-content: center;

		width: 100%;

		height: 100%;

		background: #111;

		color: #fff;

		font-family:
			"IBM Plex Mono",
			monospace;

		font-size: 0.65rem;

		letter-spacing: 0.1em;
	}


	.blog-content {

		display: flex;

		flex-direction: column;

		justify-content: center;
	}


	.blog-content h2 {

		margin:
			0 0 8px;

		font-size: 1rem;

		font-weight: 400;

		color: #fff;
	}


	.blog-content p {

		margin:
			0 0 12px;

		max-width: 600px;

		font-size: 0.75rem;

		line-height: 1.6;

		color: #888;
	}


	.blog-link {

		font-family:
			"IBM Plex Mono",
			monospace;

		font-size: 0.65rem;

		letter-spacing: 0.08em;

		color: #fff;
	}


	.blog-card:hover .blog-image img {

		opacity: 0.85;
	}


	.blog-card:hover .blog-link {

		text-decoration: underline;
	}


	@media (max-width: 700px) {

		.blog-section {

			margin-top: 20px;

			padding-left: 20px;

			padding-right: 20px;
		}


		.blog-card {

			grid-template-columns: 1fr;

			gap: 12px;

			margin-bottom: 35px;
		}


		.blog-image {

			width: 100%;

			height: auto;

			aspect-ratio: 3 / 2;
		}


		.blog-content h2 {

			font-size: 1rem;
		}


		.blog-content p {

			font-size: 0.7rem;
		}

	}

</style>