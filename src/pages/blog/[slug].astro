---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");

	return posts.map((post) => ({
		params: {
			slug: post.id
		},
		props: {
			post
		}
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} – MMKF-RS`}>

	<section class="post-page">

		<header class="post-header">

			<a href="/blog" class="back">
				← BLOG
			</a>

			<p class="date">
				{post.data.date.toLocaleDateString("de-AT")}
			</p>

			<h1>{post.data.title}</h1>

			{post.data.description && (
				<p class="description">
					{post.data.description}
				</p>
			)}

		</header>


		<article class="post-content">

			<Content />

		</article>


		<footer class="post-footer">

			<a href="/blog">
				← ZURÜCK ZUM BLOG
			</a>

		</footer>

	</section>


	<!-- LIGHTBOX -->

	<div class="lightbox" id="lightbox">

		<button
			class="lightbox-close"
			type="button"
			aria-label="Bild schließen"
		>
			×
		</button>

		<img
			class="lightbox-image"
			id="lightbox-image"
			src=""
			alt=""
		/>

	</div>


	<script>
		const images =
			document.querySelectorAll(".post-content img");

		const lightbox =
			document.getElementById("lightbox");

		const lightboxImage =
			document.getElementById("lightbox-image");

		const closeButton =
			document.querySelector(".lightbox-close");


		function closeLightbox() {

			lightbox?.classList.remove("open");

			document.body.classList.remove("lightbox-open");

			if (lightboxImage) {
				lightboxImage.setAttribute("src", "");
			}
		}


		images.forEach((image) => {

			image.addEventListener("click", () => {

				if (!lightbox || !lightboxImage) {
					return;
				}

				lightboxImage.setAttribute(
					"src",
					image.getAttribute("src") || ""
				);

				lightboxImage.setAttribute(
					"alt",
					image.getAttribute("alt") || ""
				);

				lightbox.classList.add("open");

				document.body.classList.add(
					"lightbox-open"
				);

			});

		});


		closeButton?.addEventListener(
			"click",
			closeLightbox
		);


		lightbox?.addEventListener(
			"click",
			(event) => {

				if (event.target === lightbox) {
					closeLightbox();
				}

			}
		);


		document.addEventListener(
			"keydown",
			(event) => {

				if (event.key === "Escape") {
					closeLightbox();
				}

			}
		);
	</script>

</Layout>


<style>

	/* ========================================
	   SEITE
	   ======================================== */

	.post-page {
		width: 100%;
		max-width: 1100px;

		margin: 0 auto;

		padding: 70px 40px 120px;

		box-sizing: border-box;
	}


	/* ========================================
	   HEADER
	   ======================================== */

	.post-header {
		padding-bottom: 35px;

		margin-bottom: 60px;

		border-bottom:
			1px solid
			rgba(255, 255, 255, 0.3);
	}


	.back {
		display: inline-block;

		margin-bottom: 45px;

		color: #aaa;

		font-size: 0.7rem;

		letter-spacing: 0.08em;

		text-decoration: none;
	}


	.back:hover {
		color: #fff;
	}


	.date {
		margin: 0 0 15px;

		color: #aaa;

		font-size: 0.7rem;

		letter-spacing: 0.08em;
	}


	h1 {
		margin: 0;

		font-size:
			clamp(2rem, 5vw, 4rem);

		font-weight: 400;

		line-height: 1.15;

		letter-spacing: 0.02em;
	}


	.description {
		max-width: 750px;

		margin: 25px 0 0;

		color: #ccc;

		font-size: 1rem;

		line-height: 1.7;
	}


	/* ========================================
	   ARTIKEL
	   ======================================== */

	.post-content {
		width: 100%;

		max-width: 850px;

		margin: 0 auto;

		color: #eee;

		font-size: 1rem;

		line-height: 1.8;
	}


	.post-content :global(h1),
	.post-content :global(h2),
	.post-content :global(h3),
	.post-content :global(h4) {

		color: #fff;

		font-weight: 400;

		line-height: 1.3;
	}


	.post-content :global(h1) {

		margin: 0 0 30px;

		font-size: 2.2rem;
	}


	.post-content :global(h2) {

		margin: 60px 0 25px;

		font-size: 1.6rem;
	}


	.post-content :global(h3) {

		margin: 45px 0 20px;

		font-size: 1.3rem;
	}


	.post-content :global(p) {

		margin: 0 0 25px;
	}


	.post-content :global(a) {

		color: #fff;

		text-decoration: underline;

		text-underline-offset: 3px;
	}


	.post-content :global(ul),
	.post-content :global(ol) {

		margin: 0 0 30px;

		padding-left: 25px;
	}


	.post-content :global(li) {

		margin-bottom: 8px;
	}


	/* ========================================
	   BILDER
	   ======================================== */

	.post-content :global(img) {

		display: block;

		width: auto;

		max-width: 100%;

		height: auto;

		margin: 45px auto;

		object-fit: contain;

		cursor: zoom-in;

		transition: opacity 0.2s ease;
	}


	.post-content :global(img:hover) {

		opacity: 0.9;
	}


	.post-content :global(p:has(> img)) {

		margin: 50px 0;
	}


	.post-content :global(p:has(> img) img) {

		margin: 0 auto;
	}


	.post-content :global(figure) {

		width: 100%;

		margin: 55px 0;
	}


	.post-content :global(figure img) {

		margin: 0 auto;
	}


	.post-content :global(figcaption) {

		margin-top: 10px;

		color: #999;

		font-size: 0.7rem;

		line-height: 1.5;

		letter-spacing: 0.04em;
	}


	/* ========================================
	   BLOCKQUOTE
	   ======================================== */

	.post-content :global(blockquote) {

		margin: 40px 0;

		padding: 5px 0 5px 25px;

		border-left:
			2px solid
			rgba(255, 255, 255, 0.5);

		color: #bbb;

		font-style: italic;
	}


	/* ========================================
	   CODE
	   ======================================== */

	.post-content :global(code) {

		padding: 2px 5px;

		background:
			rgba(0, 0, 0, 0.5);

		font-family:
			"IBM Plex Mono",
			monospace;
	}


	.post-content :global(pre) {

		overflow-x: auto;

		margin: 35px 0;

		padding: 20px;

		background:
			rgba(0, 0, 0, 0.7);

		border:
			1px solid
			rgba(255, 255, 255, 0.15);
	}


	.post-content :global(pre code) {

		padding: 0;

		background: none;
	}


	/* ========================================
	   ARTIKEL FOOTER
	   ======================================== */

	.post-footer {

		max-width: 850px;

		margin: 80px auto 0;

		padding-top: 25px;

		border-top:
			1px solid
			rgba(255, 255, 255, 0.25);
	}


	.post-footer a {

		color: #aaa;

		font-size: 0.7rem;

		letter-spacing: 0.08em;

		text-decoration: none;
	}


	.post-footer a:hover {

		color: #fff;
	}


	/* ========================================
	   LIGHTBOX
	   ======================================== */

	.lightbox {

		position: fixed;

		inset: 0;

		z-index: 1000;

		display: flex;

		align-items: center;

		justify-content: center;

		padding: 30px;

		box-sizing: border-box;

		background:
			rgba(0, 0, 0, 0.92);

		opacity: 0;

		visibility: hidden;

		pointer-events: none;

		transition:
			opacity 0.2s ease,
			visibility 0.2s ease;
	}


	.lightbox.open {

		opacity: 1;

		visibility: visible;

		pointer-events: auto;
	}


	.lightbox-image {

		display: block;

		max-width: 95vw;

		max-height: 92vh;

		width: auto;

		height: auto;

		object-fit: contain;

		cursor: default;
	}


	.lightbox-close {

		position: fixed;

		top: 20px;

		right: 25px;

		z-index: 1001;

		width: 45px;

		height: 45px;

		padding: 0;

		border: 0;

		background: none;

		color: #fff;

		font-family:
			"IBM Plex Mono",
			monospace;

		font-size: 2rem;

		font-weight: 300;

		line-height: 1;

		cursor: pointer;
	}


	.lightbox-close:hover {

		opacity: 0.7;
	}


	/* ========================================
	   LIGHTBOX BODY
	   ======================================== */

	:global(body.lightbox-open) {

		overflow: hidden;
	}


	/* ========================================
	   MOBIL
	   ======================================== */

	@media (max-width: 700px) {

		.post-page {

			padding:
				40px 20px 80px;
		}


		.post-header {

			margin-bottom: 40px;
		}


		.back {

			margin-bottom: 30px;
		}


		.post-content {

			font-size: 0.95rem;
		}


		.post-content :global(img) {

			margin-top: 30px;

			margin-bottom: 30px;
		}


		.lightbox {

			padding: 15px;
		}


		.lightbox-image {

			max-width: 100vw;

			max-height: 90vh;
		}


		.lightbox-close {

			top: 10px;

			right: 15px;
		}

	}

</style>